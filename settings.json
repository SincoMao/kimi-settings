{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "env": {
    "ANTHROPIC_BASE_URL": "https://api.kimi.com/coding/",
    "ANTHROPIC_API_KEY": "REPLACE_WITH_YOUR_KIMI_CODE_API_KEY",

    "ANTHROPIC_DEFAULT_OPUS_MODEL": "k3[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "k3[1m]",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "k3[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "k3[1m]",

    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "Kimi K3 (1M)",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION": "Kimi K3 / 1M context / reasoning_effort=max",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "Kimi K3 (1M)",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "Kimi K3 (background)",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking",

    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh",
    "CLAUDE_CODE_ALWAYS_ENABLE_EFFORT": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",

    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "800000",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1048576",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "131072",

    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "65536",
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "TASK_MAX_OUTPUT_LENGTH": "160000",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "3600000",

    "API_TIMEOUT_MS": "3000000",
    "API_FORCE_IDLE_TIMEOUT": "0",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "1800000",
    "CLAUDE_ENABLE_BYTE_WATCHDOG": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "MCP_TIMEOUT": "120000",
    "MCP_TOOL_TIMEOUT": "1800000",
    "CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT": "600000",
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "0",

    "CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS": "3600000",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "CLAUDE_CODE_GLOB_TIMEOUT_SECONDS": "60",

    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",

    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",

    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_ALT_SCREEN_FULL_REPAINT": "1",

    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },

  "model": "opus",
  "effortLevel": "xhigh",
  "workflowSizeGuideline": "unrestricted",
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,

  "skipWebFetchPreflight": true,

  "defaultShell": "powershell",

  "tui": "fullscreen",
  "preferredNotifChannel": "terminal_bell",

  "autoUpdatesChannel": "latest",
  "minimumVersion": "2.1.246",
  "cleanupPeriodDays": 365,

  "attribution": {
    "commit": "",
    "pr": ""
  },

  "language": "chinese-simplified",

  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Agent",
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "LSP",
      "Skill",
      "Monitor",
      "EnterWorktree",
      "Workflow",
      "WebFetch",
      "WebSearch"
    ],
    "deny": []
  },

  "skipDangerousModePermissionPrompt": true
}
